		<string>Progga needs access to your photo library to let you upload question images and profile avatars.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Progga needs access to save question solutions and results to your photo library.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Progga needs access to your microphone when recording video explanations.</string>
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>https</string>
			<string>http</string>
			<string>tel</string>
			<string>mailto</string>
		</array>
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<true/>
